---
---
<section class="hero-bg relative overflow-hidden rounded-[2rem] border border-white/10 bg-[#07111f]/90 px-6 py-16 shadow-glow">
  <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-brgreen/20 to-transparent"></div>
  <div class="mx-auto flex max-w-6xl flex-col gap-10 lg:flex-row lg:items-center">
    <div class="max-w-2xl space-y-6 text-white">
      <span class="inline-flex items-center gap-3 rounded-full border border-brgreen/30 bg-brgreen/10 px-4 py-2 text-sm font-semibold text-brgreen" data-translate="hero-tagline">
        Mobile-first portfolio for electrical projects
      </span>
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl" data-translate="hero-title">
        Electrical projects with safety, innovation and trust.
      </h1>
      <p class="max-w-xl text-slate-300 sm:text-lg" data-translate="hero-description">
        A modern portfolio that values your premium positioning and speaks directly to residential, industrial and renewable energy clients.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a href="#projetos" class="inline-flex items-center justify-center rounded-full bg-brgreen px-6 py-3 text-sm font-semibold text-slate-950 shadow-lg shadow-brgreen/20 transition hover:bg-brgreen/90" data-translate="hero-projects">
          View projects
        </a>
        <a href="#contato" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition hover:border-brgreen hover:text-brgreen" data-translate="hero-contact">
          Talk to the team
        </a>
      </div>
      <p class="mt-4 text-sm text-slate-400" data-translate="hero-price-note">Projects from 100 USD</p>
    </div>
    <div class="rounded-[2rem] border border-white/10 bg-[#08131f]/80 p-8 shadow-2xl shadow-black/40 backdrop-blur-xl">
      <p class="text-sm uppercase tracking-[0.28em] text-brgreen" data-translate="hero-highlights">Highlights</p>
      <div class="mt-8 grid gap-6">
        <div class="rounded-3xl bg-slate-950/70 p-6">
          <p class="text-sm uppercase tracking-[0.22em] text-slate-400" data-translate="hero-feature-1-label">Specialty</p>
          <p class="mt-3 font-semibold text-white" data-translate="hero-feature-1-text">Residential and industrial projects</p>
        </div>
        <div class="rounded-3xl bg-slate-950/70 p-6">
          <p class="text-sm uppercase tracking-[0.22em] text-slate-400" data-translate="hero-feature-2-label">Focus</p>
          <p class="mt-3 font-semibold text-white" data-translate="hero-feature-2-text">Efficiency, safety and technical documentation</p>
        </div>
      </div>
    </div>
  </div>
</section>
