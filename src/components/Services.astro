<section id="servicos" class="mt-24">
  <div class="mx-auto max-w-6xl">
    <div class="space-y-6 text-white">
      <span class="text-sm font-semibold uppercase tracking-[0.24em] text-brgreen" data-translate="services-label">How we can help</span>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl" data-translate="services-title">Technical approach and objective delivery.</h2>
      <p class="max-w-3xl text-slate-400" data-translate="services-description">
        Electrical projects with quality, clear documentation and focus on results that the client can use in practice.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <div class="rounded-[2rem] border border-white/10 bg-slate-950/90 p-7 shadow-glow">
        <h3 class="text-xl font-semibold text-white" data-translate="service-1-title">Technical consulting</h3>
        <p class="mt-4 text-slate-300" data-translate="service-1-description">Detailed project analysis, documentation review and improvement recommendations.</p>
      </div>
      <div class="rounded-[2rem] border border-white/10 bg-slate-950/90 p-7 shadow-glow">
        <h3 class="text-xl font-semibold text-white" data-translate="service-2-title">Complete projects</h3>
        <p class="mt-4 text-slate-300" data-translate="service-2-description">Delivery of residential and industrial projects with all electrical details ready for execution.</p>
      </div>
      <div class="rounded-[2rem] border border-white/10 bg-slate-950/90 p-7 shadow-glow">
        <h3 class="text-xl font-semibold text-white" data-translate="service-3-title">Global communication</h3>
        <p class="mt-4 text-slate-300" data-translate="service-3-description">Technical content in Portuguese and English for local and international clients.</p>
      </div>
    </div>
  </div>
</section>
