---
import '../styles/global.css';
---
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BR Eletric Engineer | Portfolio</title>
    <meta name="description" content="Electrical engineering portfolio focused on residential, industrial, renewable and automation projects." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#07111f] text-white">
    <slot />
    <script src={`${Astro.base}scripts/translations.js`}></script>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        if (window.initLanguageSwitcher) {
          window.initLanguageSwitcher();
        }
      });
    </script>
  </body>
</html>
